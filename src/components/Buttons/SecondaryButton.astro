---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  id?: string;
  icon?: string;
  class?: string;
  href?: string;
  active?: boolean;
  dataCategory?: string;
}

const { title, class: className, icon, href, id, active, dataCategory } = Astro.props as Props;
---

{
  href ? (
    <a href={import.meta.env.BASE_URL + href}>
      <button
        id={id}
        data-category={dataCategory}
        class={[
          "secondary-button",
          icon && "secondary-button--with-icon",
          active && "secondary-button--active",
          className,
        ]
          .filter(Boolean)
          .join(" ")}
      >
        {title}
        {icon ? <Icon name={icon} /> : null}
      </button>
    </a>
  ) : (
    <button
    data-category={dataCategory}
    class={[
          "secondary-button",
          icon && "secondary-button--with-icon",
          active && "secondary-button--active",
          className,
        ]
          .filter(Boolean)
          .join(" ")}
    >
      {title}
      {icon ? <Icon style="left: 2rem" name={icon} /> : null}
    </button>
  )
}

<style lang="scss">
  @use "../../styles/mixins" as *;

  .secondary-button {
    position: relative;
    background-color: var(--white-primary);
    color: var(--black-primary);
    padding: 12px;
    border: 1px solid var(--blue-primary);
    opacity: 0;
    font-size: 1rem;
    animation: slide-in-from-bottom 0.5s ease-out 0.8s;
    animation-fill-mode: forwards;
    margin-top: 1.25rem;
    transition:
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    z-index: 1;
    will-change: transform;
    backface-visibility: hidden;



    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 100%;
      background-color: var(--blue-primary);
      transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: -1;
      will-change: width;
    }
  }

  .secondary-button--with-icon {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .secondary-button:hover {
    transform: translate3d(0, -10px, 0);
    color: var(--white-primary);

    &::before {
      width: 100%;
    }
  }

  .secondary-button--active {
      background-color: var(--blue-primary);
      color: var(--white-primary);
  }
</style>
