---
interface Props {
  labels: string[];
}

import { Icon } from "astro-icon/components";
const { labels } = Astro.props;
---

<h5 class="subheading">
  {
    labels.map((label) => (
      <div>
        <Icon name="fistaszek" size="30" />
        {label}
      </div>
    ))
  }
</h5>

<style>
  .subheading {
    color: var(--grey-primary);
    opacity: 0;
    animation: slide-in-from-bottom 0.5s ease-out 0.6s;
    animation-fill-mode: forwards;

    display: flex;
    gap: 1rem;
    align-items: center;

    & > div {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  }
</style>
