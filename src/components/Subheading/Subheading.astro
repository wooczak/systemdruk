---
interface Props {
  labels: string[];
}

import { Icon } from "astro-icon/components";
const { labels } = Astro.props;
import "./Subheading.styles.scss";
---

<h5 class="subheading">
  {
    labels.map((label) => (
      <div>
        <Icon name="fistaszek" size="30" />
        {label}
      </div>
    ))
  }
</h5>
