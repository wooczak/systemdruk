---
import { Icon } from "astro-icon/components";
import "./Footer.styles.scss";
import "./Footer.responsive.styles.scss";
---

<footer id="footer" class="footer">
  <div class="footer__left-col">
    <div>
      <Icon class="footer__logo" name="systemdruk_logo" width={100} height={50} />
      <p>biuro@systemdruk.pl</p>
      <p>+48 796 070 776</p>
      <p>Adres: Igołomska 12, 30-658 Kraków</p>
    </div>
    <div class="footer__left-col__bottom-section">
      <p>Jesteśmy członkiem Małopolskiego Klastra Poligraficznego</p>
    </div>
  </div>
  <div class="footer__right-col">
    <div>
      <h6>Mapa strony</h6>
      <ul>
        <li><a href={`${import.meta.env.BASE_URL}#projects-slider`}>Realizacje</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#offer`}>Oferta</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#contact-form`}>Wycena</a></li>
        <li><a href={`${import.meta.env.BASE_URL}/blog`}>Blog</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#contact-form`}>Kontakt</a></li>
      </ul>
    </div>
    <div>
      <h6>Oferta</h6>
      <ul>
        <li><a href={`${import.meta.env.BASE_URL}/oferta/wizytowki-system-druk-krakow`}>Wizytówki</a></li>
        <li><a href={`${import.meta.env.BASE_URL}/oferta/ulotki-system-druk-krakow`}>Ulotki</a></li>
        <li><a href={`${import.meta.env.BASE_URL}/oferta/teczki-firmowe-system-druk-krakow`}>Teczki</a></li>
        <li><a href={`${import.meta.env.BASE_URL}/oferta/katalogi-szyte-system-druk-krakow`}>Katalogi</a></li>
        <li><a href={`${import.meta.env.BASE_URL}/oferta/kalendarze-system-druk-krakow`}>Kalendarze</a></li>
      </ul>
    </div>
    <div>
      <h6>Dokumenty</h6>
      <ul>
        <li>Polityka prywatności</li>
        <li>Regulamin System Druk</li>
        <li>Przygotowanie pliku do druku</li>
      </ul>
    </div>
  </div>
  <p class="footer__copyright">&copy; 2026 systemdruk.pl</p>
</footer>
