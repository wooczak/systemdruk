---
import SecondaryButton from "../Buttons/SecondaryButton.astro";
import "./Navigation.styles.scss";
import "./Navigation.styles.responsive.scss";
import { Icon } from "astro-icon/components";
import offerColumns from "./navigation.data";
---

<nav id="navigation">
  <div id="navigation__container">
    <a href={`${import.meta.env.BASE_URL}`}>
      <Icon
        name="systemdruk_logo"
        width={100}
        height={50}
        id="navigation__img"
      />
    </a>
    <ul id="navigation__list">
      <li class="navigation__item">
        <a href={`${import.meta.env.BASE_URL}/blog`}>
          <span class="nav-elevator">
            <span class="nav-elevator__text">blog</span>
            <span class="nav-elevator__text nav-elevator__text--copy">blog</span
            >
          </span>
        </a>
      </li>
      <li class="navigation__item offer-btn">
        <a>
          <span class="nav-elevator">
            <span class="nav-elevator__text">oferta</span>
            <span class="nav-elevator__text nav-elevator__text--copy"
              >oferta</span
            >
          </span>
        </a>
        <Icon
          name="mdi:keyboard-arrow-down"
          width={25}
          height={25}
          color="var(--blue-primary)"
          class="offer-icon"
        />
      </li>
      <li class="navigation__item" id="contact-link">
        <a href={`${import.meta.env.BASE_URL}#contact-form`}>
          <span class="nav-elevator">
            <span class="nav-elevator__text">kontakt</span>
            <span class="nav-elevator__text nav-elevator__text--copy"
              >kontakt</span
            >
          </span>
        </a>
      </li>
      <li class="navigation__item" id="contact-link">
        <a href={`${import.meta.env.BASE_URL}#faq`}>
          <span class="nav-elevator">
            <span class="nav-elevator__text">faq</span>
            <span class="nav-elevator__text nav-elevator__text--copy"
              >faq</span
            >
          </span>
        </a>
      </li>
    </ul>
    <SecondaryButton
      id="navigation__cta"
      href={`#contact-form`}
      title="Skontaktuj się z nami"
      icon="mdi:arrow-right"
    />
    <div class="navigation__mobile__hamburger">
      <span class="navigation__mobile__hamburger__span"></span>
      <span class="navigation__mobile__hamburger__span"></span>
      <span class="navigation__mobile__hamburger__span"></span>
    </div>
  </div>
  <div id="navigation__offer-container">
    {
      offerColumns.map((col) => (
        <div class="nav-offer-column">
          <p class="nav-offer-category">{col.category}</p>
          <ul class="sub-category-list">
            {col.links.map((link) => (
              <li>
                <a
                  href={
                    link.href && link.href.startsWith("/")
                      ? `${import.meta.env.BASE_URL}${link.href}`
                      : link.href
                  }
                >
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div id="navigation__mobile-container">
    <ul id="navigation__mobile-list">
      <li class="navigation__mobile__main-item">
        <div class="navigation__mobile__main-item__offer-btn">
          <h2 class="navigation__mobile__main-item__title">
            <a>oferta</a>
          </h2>
          <Icon
            name="mdi:keyboard-arrow-down"
            width={35}
            height={35}
            class="offer-icon"
            color="var(--blue-primary)"
          />
        </div>
        <ul class="navigation__mobile__offer-sublist">
          {
            offerColumns.map((col) => (
              <li class="navigation__mobile__offer-sublist__item">
                <h5 class="navigation__mobile__offer-sublist__item__category">
                  {col.category}
                  <Icon
                    name="mdi:keyboard-arrow-down"
                    width={16}
                    height={16}
                    class="offer-icon"
                    color="var(--white-primary)"
                  />
                </h5>
                <ul class="navigation__mobile__offer-sublist__item__links">
                  {col.links.map((link) => (
                    <li class="navigation__mobile__offer-sublist__item__links__item">
                      <a
                        href={
                          link.href && link.href.startsWith("/")
                            ? `${import.meta.env.BASE_URL}${link.href}`
                            : link.href
                        }
                      >
                        {link.text}
                      </a>
                      <Icon
                        name="mdi:keyboard-arrow-right"
                        width={16}
                        height={16}
                        class="offer-icon"
                        color="var(--white-primary)"
                      />
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </li>
      <li class="navigation__mobile__main-item">
        <h2 class="navigation__mobile__main-item__title">
          <a href={`${import.meta.env.BASE_URL}#contact-form`}>kontakt</a>
        </h2>
      </li>
      <li class="navigation__mobile__main-item">
        <h2 class="navigation__mobile__main-item__title">
          <a href={`${import.meta.env.BASE_URL}/blog`}>blog</a>
        </h2>
      </li>
      <li class="navigation__mobile__main-item">
        <h2 class="navigation__mobile__main-item__title">
          <a href={`${import.meta.env.BASE_URL}#faq`}>faq</a>
        </h2>
      </li>
    </ul>
  </div>
</nav>

<script>
  const navigation = document.getElementById("navigation") as HTMLElement;
  const navHeight = navigation.offsetHeight;
  const currentScroll = window.scrollY;

  const offerBtn = document.querySelector(".offer-btn");
  const offerContainer = document.getElementById("navigation__offer-container");

  window.addEventListener("scroll", () => {
    if (window.scrollY > currentScroll + navHeight) {
      navigation.classList.add("sticky");
    } else {
      navigation.classList.remove("sticky");
    }
  });

  offerBtn?.addEventListener("click", () => {
    offerContainer?.classList.toggle("active");
    offerBtn?.classList.toggle("active");
  });

  // Mobile navigation
  const mobileOfferBtn = document.querySelector(
    ".navigation__mobile__main-item__offer-btn",
  );
  const mobileOfferCategoryTitles = document.querySelectorAll(
    ".navigation__mobile__offer-sublist__item__category",
  );
  const hamburger = document.querySelector(".navigation__mobile__hamburger");
  const mobileContainer = document.getElementById(
    "navigation__mobile-container",
  );

  mobileOfferBtn?.addEventListener("click", () => {
    const mobileOfferSublist = document.querySelector(
      ".navigation__mobile__offer-sublist",
    );
    mobileOfferSublist?.classList.toggle("active");
    mobileOfferBtn?.classList.toggle("active");
  });

  mobileOfferCategoryTitles.forEach((title) => {
    title.addEventListener("click", () => {
      title.classList.toggle("active");
      const sublist = title.nextElementSibling as HTMLElement;
      sublist.classList.toggle("active");
    });
  });

  hamburger?.addEventListener("click", () => {
    mobileContainer?.classList.toggle("active");
    hamburger.classList.toggle("navigation__mobile__hamburger--active");
  });
</script>
