---
import SecondaryButton from "../Buttons/SecondaryButton.astro";
import "./Navigation.styles.scss";
import "./Navigation.styles.responsive.scss";
import { Icon } from "astro-icon/components";
import offerColumns from "./navigation.data";
---

<nav id="navigation">
  <div id="navigation__container">
    <a href={`${import.meta.env.BASE_URL}`}>
      <Icon
        name="systemdruk_logo"
        width={100}
        height={50}
        id="navigation__img"
      />
    </a>
    <ul id="navigation__list">
      <li class="navigation__item">
        <a href={`${import.meta.env.BASE_URL}/blog`}>
          <span class="nav-elevator">
            <span class="nav-elevator__text">blog</span>
            <span class="nav-elevator__text nav-elevator__text--copy">blog</span
            >
          </span>
        </a>
      </li>
      <li class="navigation__item offer-btn">
        <a>
          <span class="nav-elevator">
            <span class="nav-elevator__text">oferta</span>
            <span class="nav-elevator__text nav-elevator__text--copy"
              >oferta</span
            >
          </span>
        </a>
        <Icon
          name="mdi:keyboard-arrow-down"
          width={25}
          height={25}
          color="var(--blue-primary)"
          class="offer-icon"
        />
      </li>
      <li class="navigation__item" id="contact-link">
        <a href={`${import.meta.env.BASE_URL}#contact-form`}>
          <span class="nav-elevator">
            <span class="nav-elevator__text">kontakt</span>
            <span class="nav-elevator__text nav-elevator__text--copy"
              >kontakt</span
            >
          </span>
        </a>
      </li>
    </ul>
    <SecondaryButton
      id="navigation__cta"
      href={`#contact-form`}
      title="Skontaktuj sie z nami"
      icon="mdi:arrow-right"
    />
    <Icon
      name="arcticons:hamburger-menu"
      height={40}
      width={40}
      id="navigation__hamburger"
    />
  </div>
  <div id="navigation__offer-container">
    {
      offerColumns.map((col) => (
        <div class="nav-offer-column">
          <p class="nav-offer-category">{col.category}</p>
          <ul class="sub-category-list">
            {col.links.map((link) => (
              <li>
                <a
                  href={
                    link.href && link.href.startsWith("/")
                      ? `${import.meta.env.BASE_URL}${link.href}`
                      : link.href
                  }
                >
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div id="navigation__mobile-container">
    
  </div>
</nav>

<script>
  const navigation = document.getElementById("navigation") as HTMLElement;
  const navHeight = navigation.offsetHeight;
  const currentScroll = window.scrollY;

  const offerBtn = document.querySelector(".offer-btn");
  const offerContainer = document.getElementById("navigation__offer-container");

  window.addEventListener("scroll", () => {
    if (window.scrollY > currentScroll + navHeight) {
      navigation.classList.add("sticky");
    } else {
      navigation.classList.remove("sticky");
    }
  });

  offerBtn?.addEventListener("click", (e) => {
    offerContainer?.classList.toggle("active");
    offerBtn.classList.toggle("active");
  });
</script>
