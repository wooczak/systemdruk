---
import "./Hero.styles.scss";
import "./Hero.responsive.scss";
import Subheading from "../../components/Subheading/Subheading.astro";
import SecondaryButton from "../../components/Buttons/SecondaryButton.astro";
---

<section id="hero">
  <div id="hero__text-container">
    <h1 id="hero__heading">
      <div>Od 10 lat tworzymy <span>wizytówki</span></div>
      <div>które wspierają Twój biznes</div>
    </h1>
    <Subheading
      labels={[
        "Poligrafia od A do Z",
        "Fachowe doradztwo",
        "Oszczędność czasu",
      ]}
    />
    <SecondaryButton
      id="hero__secondary-mobile-btn"
      href="/#contact-form"
      title="Zamów bezpłatną wycenę"
    />
  </div>
</section>

<script is:inline>
  (() => {
    const spanText = document.querySelector("#hero__heading span");
    if (!spanText) {
      return;
    }

    const textsToShowcase = [
      "ulotki,",
      "plakaty,",
      "katalogi,",
      "naklejki,",
      "teczki,",
      "gadżety,",
    ];

    const ANIMATE_OUT_DURATION = 300;
    const ANIMATE_IN_DURATION = 300;
    const DISPLAY_DURATION = 1000;

    let currentIndex = 0;

    function cycleHeroText() {
      spanText.classList.add("animate-out");
      spanText.style.setProperty("--animate-duration", `${ANIMATE_OUT_DURATION}ms`);

      setTimeout(() => {
        spanText.classList.remove("animate-out");
        currentIndex = (currentIndex + 1) % textsToShowcase.length;
        spanText.textContent = textsToShowcase[currentIndex];
        spanText.classList.add("animate-in");
        spanText.style.setProperty("--animate-duration", `${ANIMATE_IN_DURATION}ms`);

        setTimeout(() => {
          spanText.classList.remove("animate-in");
          setTimeout(cycleHeroText, DISPLAY_DURATION);
        }, ANIMATE_IN_DURATION);
      }, ANIMATE_OUT_DURATION);
    }

    setTimeout(cycleHeroText, DISPLAY_DURATION);
  })();
</script>
