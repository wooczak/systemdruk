---
import "./Hero.styles.scss";

import SecondaryButton from "../../components/Buttons/SecondaryButton.astro";
import Subheading from "../../components/Subheading/Subheading.astro";
---

<section id="hero">
  <div id="hero__text-container">
    <h1 id="hero__heading">
      <div>Od 10 lat tworzymy <span>wizytówki</span></div>
      <div>które wspierają Twój biznes</div>
    </h1>
    <Subheading
      labels={["Poligrafia od A do Z", "Fachowe doradztwo", "Oszczędność czasu"]}
    />
    <SecondaryButton href="#contact-form" title="Skontaktuj się z nami" />
  </div>
</section>

<script>
  const spanText = document.querySelector(
    "#hero__heading span",
  ) as HTMLSpanElement;

  let textsToShowcase = [
    "ulotki,",
    "plakaty,",
    "katalogi,",
    "naklejki,",
    "teczki,",
    "gadżety,",
  ];

  const ANIMATE_OUT_DURATION = 300;
  const ANIMATE_IN_DURATION = 300;
  const DISPLAY_DURATION = 1000;

  const CYCLE_DURATION =
    DISPLAY_DURATION + ANIMATE_OUT_DURATION + ANIMATE_IN_DURATION;

  const FAST_ANIMATE_DURATION = 100; // Faster animations during fast cycling
  const FAST_CYCLE_DURATION = 150; // Fast cycle during initial 2 seconds
  const FAST_DURATION = 1000; // 2 seconds of fast cycling

  let currentIndex = 0;
  let startTime = Date.now();
  let intervalId: number;
  let isFastMode = true;

  const cycle = () => {
    const animateOutDuration = isFastMode ? FAST_ANIMATE_DURATION : ANIMATE_OUT_DURATION;
    const animateInDuration = isFastMode ? FAST_ANIMATE_DURATION : ANIMATE_IN_DURATION;

    // Set animation duration via CSS custom property
    spanText.style.setProperty('--animate-duration', `${animateOutDuration}ms`);

    spanText.classList.add("animate-out");

    setTimeout(() => {
      spanText.classList.remove("animate-out");
      currentIndex = (currentIndex + 1) % textsToShowcase.length;
      spanText.textContent = textsToShowcase[currentIndex];
      spanText.classList.add("animate-in");

      setTimeout(() => {
        spanText.classList.remove("animate-in");
      }, animateInDuration);
    }, animateOutDuration);
  };

  // Start with fast cycling
  intervalId = setInterval(cycle, FAST_CYCLE_DURATION);

  // After 2 seconds, transition to normal speed
  setTimeout(() => {
    clearInterval(intervalId);
    isFastMode = false;
    intervalId = setInterval(cycle, CYCLE_DURATION);
  }, FAST_DURATION);
</script>
