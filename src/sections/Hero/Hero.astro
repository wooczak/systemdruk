---
import "./Hero.styles.scss";

import Company1Logo from "../../assets/images/slider/cae-company-logo-systemdruk-client.svg";
import Company2Logo from "../../assets/images/slider/comarch-company-logo-systemdruk-client.png";
import Company3Logo from "../../assets/images/slider/hm-company-logo-systemdruk-client.png";
import Company4Logo from "../../assets/images/slider/maxfliz-company-logo-systemdruk-client.png";
import Company5Logo from "../../assets/images/slider/obsessive-logo-systemdruk-client.png";
import Company6Logo from "../../assets/images/slider/oknoplus-company-logo-systemdruk-client.svg";
import Company7Logo from "../../assets/images/slider/traficar-company-logo-systemdruk-client.png";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<section id="hero">
  <div id="hero__text-container">
    <h1 id="hero__heading">
      <div>Ponad 10 lat doświadczenia</div>
      <div>w tworzeniu <span>wizytówek</span></div>
      <div>które wspierają Twój biznes</div>
    </h1>
    <h5 id="hero__subheading">
      <div>
        <Icon name="fistaszek" size="30" />
        Poligrafia od A do Z
      </div>
      <div>
        <Icon name="fistaszek" size="30" />
        Fachowe doradztwo
      </div>
      <div>
        <Icon name="fistaszek" size="30" />
        Oszczędność czasu
      </div>
    </h5>
    <button id="hero__cta-button"> Skontaktuj się z nami </button>
  </div>

  <section id="hero__slider-container" aria-labelledby="carousel-heading">
    <h4 id="carousel-heading">Dołącz do firm, które nam zaufały</h4>
    <div
      class="hero-slider"
      role="group"
      aria-label="Splide Basic HTML Example"
    >
      <div class="hero-slider__track">
        <ul class="hero-slider__list">
          <li class="hero-slider__slide">
            <Image src={Company1Logo} alt="Company 1 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company2Logo} alt="Company 2 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company3Logo} alt="Company 3 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company4Logo} alt="Company 4 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company5Logo} alt="Company 5 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company6Logo} alt="Company 6 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company7Logo} alt="Company 7 Logo" height="35" />
          </li>
        </ul>
        <ul class="hero-slider__list" aria-hidden>
          <li class="hero-slider__slide">
            <Image src={Company1Logo} alt="Company 1 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company2Logo} alt="Company 2 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company3Logo} alt="Company 3 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company4Logo} alt="Company 4 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company5Logo} alt="Company 5 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company6Logo} alt="Company 6 Logo" height="35" />
          </li>
          <li class="hero-slider__slide">
            <Image src={Company7Logo} alt="Company 7 Logo" height="35" />
          </li>
        </ul>
      </div>
    </div>
  </section>
</section>

<script>
  const spanText = document.querySelector(
    "#hero__heading span",
  ) as HTMLSpanElement;

  let textsToShowcase = [
    "ulotek,",
    "plakatów,",
    "katalogów,",
    "naklejek,",
    "teczek,",
    "materiałów reklamowych,",
  ];

  const ANIMATE_OUT_DURATION = 300;
  const ANIMATE_IN_DURATION = 300;
  const DISPLAY_DURATION = 1000;

  const CYCLE_DURATION =
    DISPLAY_DURATION + ANIMATE_OUT_DURATION + ANIMATE_IN_DURATION;

  let currentIndex = 0;

  setInterval(() => {
    spanText.classList.add("animate-out");

    setTimeout(() => {
      spanText.classList.remove("animate-out");
      currentIndex = (currentIndex + 1) % textsToShowcase.length;
      spanText.textContent = textsToShowcase[currentIndex];
      spanText.classList.add("animate-in");

      setTimeout(() => {
        spanText.classList.remove("animate-in");
      }, ANIMATE_IN_DURATION);
    }, ANIMATE_OUT_DURATION);
  }, CYCLE_DURATION);
</script>
