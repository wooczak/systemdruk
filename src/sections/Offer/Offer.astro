---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import "./Offer.styles.scss";
import "./Offer.responsive.styles.scss";
import FirstCategorySrc from "../../assets/images/offer/druk-cyfrowy.webp";
import SecondCategorySrc from "../../assets/images/offer/gadzety.webp";
import ThirdCategorySrc from "../../assets/images/offer/reklama-zewnetrzna.webp";
import FourthCategorySrc from "../../assets/images/offer/pudelka-i-torby.webp";
---

<section class="offer">
  <h1 class="offer__title animate-on-scroll">Poznaj naszą ofertę</h1>

  <section class="offer__content-grid animate-on-scroll">
    <div class="offer__content-grid-left">
      <h2 class="offer__content-heading active">Druk offsetowy i cyfrowy</h2>
      <h2 class="offer__content-heading">Gadżety reklamowe</h2>
      <h2 class="offer__content-heading">Reklama zewnętrzna</h2>
      <h2 class="offer__content-heading">Pudełka i torby z logo</h2>
    </div>

    <div class="offer__content-grid-right">
      <div class="offer__content-grid-right-content">
        <div class="offer__content__slide-overlay"></div>
        <Image
          src={FirstCategorySrc}
          alt="Oferta"
          class="offer__image"
          width={400}
          height={400}
          data-images={JSON.stringify([
            FirstCategorySrc.src,
            SecondCategorySrc.src,
            ThirdCategorySrc.src,
            FourthCategorySrc.src,
          ])}
        />
        <!-- 1 -->
        <h5 class="offer__mobile-heading active">Druk offsetowy i cyfrowy</h5>
        <div class="offer__content__text-container active">
          <p class="offer__content-subheading">
            Specjalizujemy się w produkcji zleceń średnio- i niskonakładowych
            (druk cyfrowy) oraz wysokonakładowych (druk offsetowy).
            Projektujemy, doradzamy i dobieramy podłoża oraz uszlachetnienia
            dopasowane do Twojej branży i specjalizacji. Wolisz szybki czas
            realizacji czy niższą cenę przy dużych nakładach? Skontaktuj się z
            nami — pomożemy dobrać najlepsze rozwiązanie.
          </p>

          <ul class="offer__content-text">
            <li><a href="#"><Icon name="mdi:arrow-right" /> Wizytówki</a></li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Notesy</a></li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Katalogi szyte</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Katalogi klejone</a>
            </li>
            <li>
              <a href="#"
                ><Icon name="mdi:arrow-right" /> Katalogi z registrami</a
              >
            </li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Segregatory</a></li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Plakaty</a></li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Ulotki</a></li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Teczki firmowe</a>
            </li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Kalendarze</a></li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Biuwary</a></li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Karty plastikowe</a>
            </li>
            <li>
              <a href="#"
                ><Icon name="mdi:arrow-right" /> Opakowania kartonowe</a
              >
            </li>
          </ul>
        </div>

        <!-- 2 -->
        <h5 class="offer__mobile-heading">Gadzety reklamowe</h5>
        <div class="offer__content__text-container">
          <p class="offer__content-subheading">
            Oferujemy szeroki wybór gadżetów reklamowych — od prostych produktów
            biurowych po personalizowane upominki premium. To doskonały sposób
            na budowanie relacji i podziękowanie za współpracę. Wspólnie
            wybieramy spośród setek produktów, które najlepiej zaprezentują
            Twoje logo i wzmocnią rozpoznawalność marki.
          </p>

          <ul class="offer__content-text">
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Gadżety biurowe</a>
            </li>
            <li>
              <a href="#"
                ><Icon name="mdi:arrow-right" /> Ceramika z nadrukiem</a
              >
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Smycze reklamowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Parasole z logo</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Koszulki z logo</a>
            </li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Breloki</a></li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Pendrive</a></li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Kalendarze firmowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Notesy biurkowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Elektronika z logo</a>
            </li>
          </ul>
        </div>

        <!-- 3 -->
        <h5 class="offer__mobile-heading">Reklama zewnetrzna</h5>
        <div class="offer__content__text-container">
          <p class="offer__content-subheading">
            Wspieramy klientów w działaniach outdoorowych, targach i
            konferencjach — od projektu po realizację i logistykę. Doradzamy w
            zakresie grupy odbiorców i budżetu, bo wierzymy, że skuteczna
            reklama zewnętrzna to klucz do rozpoznawalności marki.
          </p>

          <ul class="offer__content-text">
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Rollupy reklamowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Ścianki reklamowe</a>
            </li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Ścianki LED</a></li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Standy</a></li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Flagi reklamowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Trybunki i lady</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Obrusy firmowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Namioty reklamowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Kasetony i pylony</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Reklama świetlna</a>
            </li>
            <li><a href="#"><Icon name="mdi:arrow-right" /> Reklama 3D</a></li>
          </ul>
        </div>

        <!-- 4 -->
        <h5 class="offer__mobile-heading">Pudelka i torby z logo</h5>
        <div class="offer__content__text-container">
          <p class="offer__content-subheading">
            Projektujemy i produkujemy opakowania oraz torby firmowe, które są
            nie tylko estetyczne, ale i funkcjonalne. Wspieramy e-commerce,
            gastronomię i firmy usługowe. Oferujemy ponad 100 wykrojników oraz
            szeroki zakres uszlachetnień — od folii piaskowej po lakier 3D.
            Nawet przy niskich nakładach możesz prezentować się profesjonalnie.
          </p>

          <ul class="offer__content-text">
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Torby bawełniane</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Torby papierowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Torby firmowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Torby na wino</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Pudełka z magnesem</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Pudełka fasonowe</a>
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Pudełka z nadrukiem</a
              >
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Nadruk na pudełkach</a
              >
            </li>
            <li>
              <a href="#"><Icon name="mdi:arrow-right" /> Projekty firmowe</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const headings = document.querySelectorAll('.offer__content-heading');
    const contents = document.querySelectorAll('.offer__content__text-container');
    const image = document.querySelector('.offer__image');
    const overlay = document.querySelector('.offer__content__slide-overlay');
    let isAnimating = false;

    const categoryImages = image ? JSON.parse(image.dataset.images || '[]') : [];

    console.log('Offer init', { headings: headings.length, contents: contents.length, overlay: !!overlay });

    // Debug: capture all clicks to verify events reach the page
    document.addEventListener('click', (ev) => {
      console.log('document click', ev.type, ev.target && (ev.target as HTMLElement).className);
    }, true);

    // Debug: log geometry and pointer-events of first heading and overlay
    if (headings[0]) {
      const h = headings[0];
      console.log('heading[0] rect', h.getBoundingClientRect(), 'pointerEvents', window.getComputedStyle(h).pointerEvents);
    }
    if (overlay) {
      console.log('overlay rect', overlay.getBoundingClientRect(), 'pointerEvents', window.getComputedStyle(overlay).pointerEvents, 'z', overlay.style.zIndex);
    }

    // Set initial overlay state (out if there's an active content)
    if (overlay) {
      overlay.style.transform = document.querySelector('.offer__content__text-container.active') ? 'translateX(100%)' : 'translateX(0)';
    }

    headings.forEach((heading, index) => {
      console.log('Offer: attach handler', index);
      heading.addEventListener('click', () => {
        console.log('offer heading click', index);
        if (isAnimating) return;

        if (!contents[index]) {
          console.warn('Offer: no matching content for heading index', index);
          return;
        }

        const currentActive = document.querySelector('.offer__content__text-container.active');
        if (currentActive === contents[index]) return;

        isAnimating = true;

        // Immediate swap so UI updates reliably even if overlay transition misfires
        headings.forEach((h) => h.classList.remove('active'));
        contents.forEach((c) => c.classList.remove('active'));
        heading.classList.add('active');
        contents[index].classList.add('active');
        if (image && categoryImages[index]) image.src = categoryImages[index];
        console.log('offer immediate swap to index', index);

        // Try a short overlay animation for polish but don't rely on transitionend
        if (overlay) {
          // ensure we block clicks briefly while animation runs
          isAnimating = true;
          requestAnimationFrame(() => {
            overlay.style.transform = 'translateX(0)';
            // reveal after a short delay to keep visual flow
            setTimeout(() => {
              overlay.style.transform = 'translateX(100%)';
            }, 120);
          });
          // Clear the animation lock after a short timeout so clicks become active again
          setTimeout(() => {
            isAnimating = false;
          }, 380);
        } else {
          // No overlay — allow immediate next interactions
          isAnimating = false;
        }
      });
    });

    // Mobile: toggle content when tapping mobile headings (h5)
    const mobileHeadings = document.querySelectorAll('.offer__mobile-heading');
    mobileHeadings.forEach((mHeading) => {
      mHeading.addEventListener('click', () => {
        if (mHeading.classList.contains('active')) return;

        const currentHeading = document.querySelector('.offer__mobile-heading.active');
        const currentContent = document.querySelector('.offer__content__text-container.active');

        if (currentHeading) currentHeading.classList.remove('active');
        if (currentContent) currentContent.classList.remove('active');

        mHeading.classList.add('active');
        const related = mHeading.nextElementSibling;
        if (related && related.classList.contains('offer__content__text-container')) {
          related.classList.add('active');
        }
      });
    });

    // Scroll animations
    const intersectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      {
        threshold: 0.2,
        rootMargin: '0px 0px -100px 0px',
      },
    );

    document.querySelectorAll('.animate-on-scroll').forEach((element) => {
      intersectionObserver.observe(element);
    });
  });
</script>
