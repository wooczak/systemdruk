---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import "./Offer.styles.scss";
import "./Offer.responsive.styles.scss";
import FirstCategorySrc from "../../assets/images/offer/druk-cyfrowy.webp";
import SecondCategorySrc from "../../assets/images/offer/gadzety.webp";
import ThirdCategorySrc from "../../assets/images/offer/reklama-zewnetrzna.webp";
import FourthCategorySrc from "../../assets/images/offer/pudelka-i-torby.webp";
---

<section class="offer">
  <h1 class="offer__title animate-on-scroll">Poznaj naszą ofertę</h1>

  <section class="offer__content-grid animate-on-scroll">
    <div class="offer__content-grid-left">
      <h2 class="offer__content-heading active">Druk offsetowy i cyfrowy</h2>
      <h2 class="offer__content-heading">Gadżety reklamowe</h2>
      <h2 class="offer__content-heading">Reklama zewnętrzna</h2>
      <h2 class="offer__content-heading">Pudełka i torby z logo</h2>
    </div>

    <div class="offer__content-grid-right">
      <div class="offer__content-grid-right-content">
        <div class="offer__content__slide-overlay"></div>
        <Image
          src={FirstCategorySrc}
          alt="Oferta"
          class="offer__image"
          width={400}
          height={400}
          data-images={JSON.stringify([
            FirstCategorySrc.src,
            SecondCategorySrc.src,
            ThirdCategorySrc.src,
            FourthCategorySrc.src,
          ])}
        />
        <!-- 1 -->
        <h5 class="offer__mobile-heading active">Druk offsetowy i cyfrowy</h5>
        <div class="offer__content__text-container active">
          <p class="offer__content-subheading">
            Specjalizujemy się w produkcji zleceń średnio- i niskonakładowych
            (druk cyfrowy) oraz wysokonakładowych (druk offsetowy).
            Projektujemy, doradzamy i dobieramy podłoża oraz uszlachetnienia
            dopasowane do Twojej branży i specjalizacji. Wolisz szybki czas
            realizacji czy niższą cenę przy dużych nakładach? Skontaktuj się z
            nami — pomożemy dobrać najlepsze rozwiązanie.
          </p>

          <ul class="offer__content-text">
            <li><a href={`${import.meta.env.BASE_URL}/oferta/wizytowki-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Wizytówki</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/notesy-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Notesy</a></li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/katalogi-szyte-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Katalogi szyte</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/katalogi-klejone-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Katalogi klejone</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/katalogi-z-registrami-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Katalogi z registrami</a>
            </li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/segregatory-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Segregatory</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/plakaty-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Plakaty</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/ulotki-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Ulotki</a></li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/teczki-firmowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Teczki firmowe</a>
            </li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/kalendarze-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Kalendarze</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/biuwary-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Biuwary</a></li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/karty-plastikowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Karty plastikowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/opakowania-kartonowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Opakowania kartonowe</a>
            </li>
          </ul>
        </div>

        <!-- 2 -->
        <h5 class="offer__mobile-heading">Gadzety reklamowe</h5>
        <div class="offer__content__text-container">
          <p class="offer__content-subheading">
            Oferujemy szeroki wybór gadżetów reklamowych — od prostych produktów
