          <ul class="offer__content-text">
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/gadzety-biurowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Gadżety biurowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/ceramika-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Ceramika z nadrukiem</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/smycze-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Smycze reklamowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/parasole-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Parasole z logo</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/koszulki-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Koszulki z logo</a>
            </li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/breloki-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Breloki</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/pendrive-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Pendrive</a></li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/kalendarze-firmowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Kalendarze firmowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/notesy-biurkowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Notesy biurkowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/elektronika-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Elektronika z logo</a>
            </li>
          </ul>
        </div>

        <!-- 3 -->
        <h5 class="offer__mobile-heading">Reklama zewnetrzna</h5>
        <div class="offer__content__text-container">
          <p class="offer__content-subheading">
            Wspieramy klientów w działaniach outdoorowych, targach i
            konferencjach — od projektu po realizację i logistykę. Doradzamy w
            zakresie grupy odbiorców i budżetu, bo wierzymy, że skuteczna
            reklama zewnętrzna to klucz do rozpoznawalności marki.
          </p>

          <ul class="offer__content-text">
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/rollupy-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Rollupy reklamowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/scianki-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Ścianki reklamowe</a>
            </li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/scianki-led-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Ścianki LED</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/standy-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Standy</a></li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/flagi-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Flagi reklamowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/trybunki-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Trybunki i lady</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/obrusy-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Obrusy firmowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/namioty-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Namioty reklamowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/kasetony-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Kasetony i pylony</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/reklama-swietlna-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Reklama świetlna</a>
            </li>
            <li><a href={`${import.meta.env.BASE_URL}/oferta/reklama-3d-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Reklama 3D</a></li>
          </ul>
        </div>

        <!-- 4 -->
        <h5 class="offer__mobile-heading">Pudelka i torby z logo</h5>
        <div class="offer__content__text-container">
          <p class="offer__content-subheading">
            Projektujemy i produkujemy opakowania oraz torby firmowe, które są
            nie tylko estetyczne, ale i funkcjonalne. Wspieramy e-commerce,
            gastronomię i firmy usługowe. Oferujemy ponad 100 wykrojników oraz
            szeroki zakres uszlachetnień — od folii piaskowej po lakier 3D.
            Nawet przy niskich nakładach możesz prezentować się profesjonalnie.
          </p>

          <ul class="offer__content-text">
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/torby-bawełniane-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Torby bawełniane</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/torby-papierowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Torby papierowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/torby-firmowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Torby firmowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/torby-na-wino-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Torby na wino</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/pudelka-z-magnesem-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Pudełka z magnesem</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/pudelka-fasonowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Pudełka fasonowe</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/pudelka-nadruk-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Pudełka z nadrukiem</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/nadruk-pudelka-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Nadruk na pudełkach</a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}/oferta/projekty-firmowe-system-druk-krakow`}><Icon name="mdi:arrow-right" /> Projekty firmowe</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const headings = document.querySelectorAll<HTMLHeadingElement>('.offer__content-heading');
    const contents = document.querySelectorAll<HTMLDivElement>('.offer__content__text-container');
    const image = document.querySelector<HTMLImageElement>('.offer__image');
    const overlay = document.querySelector<HTMLDivElement>('.offer__content__slide-overlay');
    let isAnimating = false;

    const categoryImages: string[] = image ? JSON.parse(image.dataset.images || '[]') : [];

    const moveOverlay = (transform: string) => {
      if (!overlay) return Promise.resolve();

      return new Promise<void>((resolve) => {
        let timeoutId = 0;
        const finish = () => {
          overlay.removeEventListener('transitionend', onTransitionEnd);
          window.clearTimeout(timeoutId);
          resolve();
        };
        const onTransitionEnd = (event: TransitionEvent) => {
          if (event.target === overlay && event.propertyName === 'transform') {
            finish();
          }
        };

        overlay.addEventListener('transitionend', onTransitionEnd);
        timeoutId = window.setTimeout(finish, 700);
        requestAnimationFrame(() => {
          overlay.style.transform = transform;
        });
      });
    };

    if (overlay) {
      overlay.style.transform = document.querySelector('.offer__content__text-container.active')
        ? 'translateX(100%)'
        : 'translateX(0)';
    }

    headings.forEach((heading, index) => {
      heading.addEventListener('click', async () => {
        if (isAnimating) return;

        if (!contents[index]) {
          console.warn('Offer: no matching content for heading index', index);
          return;
        }

        const currentActive = document.querySelector('.offer__content__text-container.active');
        if (currentActive === contents[index]) return;

        isAnimating = true;

        if (overlay) await moveOverlay('translateX(0)');

        headings.forEach((h) => h.classList.remove('active'));
        contents.forEach((c) => c.classList.remove('active'));
        heading.classList.add('active');
        contents[index].classList.add('active');
        if (image && categoryImages[index]) image.src = categoryImages[index];

        if (overlay) await moveOverlay('translateX(100%)');
        isAnimating = false;
      });
    });

    // Mobile: toggle content when tapping mobile headings (h5)
    const mobileHeadings = document.querySelectorAll('.offer__mobile-heading');
    mobileHeadings.forEach((mHeading) => {
      mHeading.addEventListener('click', () => {
        if (mHeading.classList.contains('active')) return;

        const currentHeading = document.querySelector('.offer__mobile-heading.active');
        const currentContent = document.querySelector('.offer__content__text-container.active');

        if (currentHeading) currentHeading.classList.remove('active');
        if (currentContent) currentContent.classList.remove('active');

        mHeading.classList.add('active');
        const related = mHeading.nextElementSibling;
        if (related && related.classList.contains('offer__content__text-container')) {
          related.classList.add('active');
        }
      });
    });

    // Scroll animations
    const intersectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      {
        threshold: 0.2,
        rootMargin: '0px 0px -100px 0px',
      },
    );

    document.querySelectorAll('.animate-on-scroll').forEach((element) => {
      intersectionObserver.observe(element);
    });
  });
</script>
