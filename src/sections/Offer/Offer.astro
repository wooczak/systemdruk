---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ImageOffer from "../../assets/images/offer-banner.jpg";
import "./Offer.styles.scss";
import FirstCategorySrc from "../../assets/images/offer/druk-cyfrowy.webp";
import SecondCategorySrc from "../../assets/images/offer/gadzety.webp";
import ThirdCategorySrc from "../../assets/images/offer/reklama-zewnetrzna.webp";
import FourthCategorySrc from "../../assets/images/offer/pudelka-i-torby.webp";
---

<section class="offer">
  <h1>Poznaj naszą ofertę</h1>

  <Image
    src={FirstCategorySrc}
    alt="Oferta"
    class="offer__image"
    width={400}
    height={400}
    data-images={JSON.stringify([
      FirstCategorySrc.src,
      SecondCategorySrc.src,
      ThirdCategorySrc.src,
      FourthCategorySrc.src
    ])}
  />

  <section class="offer__content-grid">
    <div class="offer__content-grid-left">
      <h2 class="offer__content-heading active">Druk offsetowy i cyfrowy</h2>
      <h2 class="offer__content-heading">Gadżety reklamowe</h2>
      <h2 class="offer__content-heading">Reklama zewnętrzna</h2>
      <h2 class="offer__content-heading">Pudełka i torby z logo</h2>
    </div>

    <div class="offer__content-grid-right">
      <!-- 1 -->
      <div class="offer__content__text-container active">
        <div class="offer__content__slide-overlay"></div>
        <p class="offer__content-subheading">
          Specjalizujemy się w produkcji zleceń średnio- i niskonakładowych
          (druk cyfrowy) oraz wysokonakładowych (druk offsetowy). 
          Projektujemy, doradzamy i dobieramy podłoża oraz uszlachetnienia 
          dopasowane do Twojej branży i specjalizacji. 
          Wolisz szybki czas realizacji czy niższą cenę przy dużych nakładach? 
          Skontaktuj się z nami — pomożemy dobrać najlepsze rozwiązanie.
        </p>

        <ul class="offer__content-text">
          <li><a href="#"><Icon name="mdi:arrow-right" /> Wizytówki</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Notesy</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Katalogi szyte</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Katalogi klejone</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Katalogi z registrami</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Segregatory</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Plakaty</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Ulotki</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Teczki firmowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Kalendarze</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Biuwary</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Karty plastikowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Opakowania kartonowe</a></li>
        </ul>
      </div>

      <!-- 2 -->
      <div class="offer__content__text-container">
        <div class="offer__content__slide-overlay"></div>
        <p class="offer__content-subheading">
          Oferujemy szeroki wybór gadżetów reklamowych — od prostych produktów 
          biurowych po personalizowane upominki premium. To doskonały sposób 
          na budowanie relacji i podziękowanie za współpracę. 
          Wspólnie wybieramy spośród setek produktów, które najlepiej 
          zaprezentują Twoje logo i wzmocnią rozpoznawalność marki.
        </p>

        <ul class="offer__content-text">
          <li><a href="#"><Icon name="mdi:arrow-right" /> Gadżety biurowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Ceramika z nadrukiem</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Smycze reklamowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Parasole z logo</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Koszulki z logo</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Breloki</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Pendrive</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Kalendarze firmowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Notesy biurkowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Elektronika z logo</a></li>
        </ul>
      </div>

      <!-- 3 -->
      <div class="offer__content__text-container">
        <div class="offer__content__slide-overlay"></div>
        <p class="offer__content-subheading">
          Wspieramy klientów w działaniach outdoorowych, targach i konferencjach 
          — od projektu po realizację i logistykę. Doradzamy w zakresie grupy 
          odbiorców i budżetu, bo wierzymy, że skuteczna reklama zewnętrzna 
          to klucz do rozpoznawalności marki.
        </p>

        <ul class="offer__content-text">
          <li><a href="#"><Icon name="mdi:arrow-right" /> Rollupy reklamowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Ścianki reklamowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Ścianki LED</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Standy</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Flagi reklamowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Trybunki i lady</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Obrusy firmowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Namioty reklamowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Kasetony i pylony</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Reklama świetlna</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Reklama 3D</a></li>
        </ul>
      </div>

      <!-- 4 -->
      <div class="offer__content__text-container">
        <div class="offer__content__slide-overlay"></div>
        <p class="offer__content-subheading">
          Projektujemy i produkujemy opakowania oraz torby firmowe, które są 
          nie tylko estetyczne, ale i funkcjonalne. Wspieramy e-commerce, 
          gastronomię i firmy usługowe. Oferujemy ponad 100 wykrojników oraz 
          szeroki zakres uszlachetnień — od folii piaskowej po lakier 3D. 
          Nawet przy niskich nakładach możesz prezentować się profesjonalnie.
        </p>

        <ul class="offer__content-text">
          <li><a href="#"><Icon name="mdi:arrow-right" /> Torby bawełniane</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Torby papierowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Torby firmowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Torby na wino</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Pudełka z magnesem</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Pudełka fasonowe</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Pudełka z nadrukiem</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Nadruk na pudełkach</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Projekty firmowe</a></li>
        </ul>
      </div>
    </div>
  </section>
</section>

<script>
  const headings = document.querySelectorAll(".offer__content-heading");
  const contents = document.querySelectorAll(".offer__content__text-container");
  const image = document.querySelector(".offer__image") as HTMLImageElement;
  let isAnimating = false;

  const categoryImages = JSON.parse(image.dataset.images || "[]");

  headings.forEach((heading, index) => {
    heading.addEventListener("click", () => {
      if (isAnimating) return;

      const currentActive = document.querySelector(".offer__content__text-container.active");
      if (currentActive === contents[index]) return;

      isAnimating = true;

      // Update image source
      if (categoryImages[index]) {
        image.src = categoryImages[index];
      }

      // Hide current content by sliding overlay in
      if (currentActive) {
        currentActive.classList.add("hiding");

        setTimeout(() => {
          // Remove active from all
          headings.forEach((h) => h.classList.remove("active"));
          contents.forEach((c) => {
            c.classList.remove("active");
            c.classList.remove("hiding");
          });

          // Activate new content
          heading.classList.add("active");
          contents[index].classList.add("active");

          isAnimating = false;
        }, 600); // Match transition duration
      } else {
        heading.classList.add("active");
        contents[index].classList.add("active");
        isAnimating = false;
      }
    });
  });
</script>
