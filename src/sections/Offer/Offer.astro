---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ImageOffer from "../../assets/images/offer-banner.jpg";
import "./Offer.styles.scss";
---

<section class="offer">
  <h3>Oferta</h3>

  <Image
    src={ImageOffer}
    alt="Oferta"
    class="offer__image"
    width={400}
    height={400}
  />

  <section class="offer__content-grid">
    <div class="offer__content-grid-left">
      <h2 class="offer__content-heading active">Druk offsetowy i cyfrowy</h2>
      <h2 class="offer__content-heading">Gadżety reklamowe</h2>
      <h2 class="offer__content-heading">Reklama zewnętrzna</h2>
      <h2 class="offer__content-heading">Pudełka i torby z logo</h2>
    </div>

    <div class="offer__content-grid-right">
      <!-- 1 -->
      <div class="offer__content__text-container active">
        <p class="offer__content-subheading">
          Specjalizujemy się w produkcji zleceń średnio- i niskonakładowych
          (druk cyfrowy) oraz wysokonakładowych (druk offsetowy). Doradzamy,
          projektujemy i dobieramy odpowiednie podłoża oraz uszlachetnienia
          dopasowane do Twojej branży. Wolisz szybki czas realizacji czy niższą
          cenę przy dużych nakładach? Skontaktuj się z nami — pomożemy dobrać
          najlepsze rozwiązanie.
        </p>

        <ul class="offer__content-text">
          <li><a href="#"><Icon name="mdi:arrow-right" /> Wizytówki</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Ulotki</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Plakaty</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Notesy</a></li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Katalogi szyte</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Katalogi klejone</a>
          </li>
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Katalogi z registrami</a>
          </li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Segregatory</a></li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Teczki firmowe</a>
          </li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Kalendarze</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Biuwary</a></li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Karty plastikowe</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Opakowania kartonowe</a>
          </li>
        </ul>
      </div>

      <!-- 2 -->
      <div class="offer__content__text-container">
        <p class="offer__content-subheading">
          Kompleksowa oferta gadżetów reklamowych — od prostych materiałów
          biurowych po premium personalizowane upominki. Pomagamy dobrać
          produkty, które skutecznie budują rozpoznawalność Twojej marki i
          relacje z klientami.
        </p>

        <ul class="offer__content-text">
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Smycze reklamowe</a>
          </li>
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Breloki (soft PVC 2D)</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Długopisy z grawerem</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Kubki i filiżanki</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Koszulki z logo</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Torby bawełniane</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Parasole z logo</a>
          </li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Pendrive</a></li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Gadżety biurowe</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Notesy i kalendarze</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Elektronika z logo</a>
          </li>
        </ul>
      </div>

      <!-- 3 -->
      <div class="offer__content__text-container">
        <p class="offer__content-subheading">
          Wspieramy firmy w działaniach outdoorowych, targach i konferencjach.
          Od projektu po realizację i logistykę — dbamy o spójność i skuteczność
          Twojej komunikacji wizualnej.
        </p>

        <ul class="offer__content-text">
          <li><a href="#"><Icon name="mdi:arrow-right" /> Rollupy</a></li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Ścianki reklamowe</a>
          </li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Ścianki LED</a></li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Standy</a></li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Flagi reklamowe</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Trybunki i lady</a>
          </li>
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Obrazy i obrusy firmowe</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Namioty reklamowe</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Kasetony i pylony</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Reklama świetlna</a>
          </li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Reklama 3D</a></li>
        </ul>
      </div>

      <!-- 4 -->
      <div class="offer__content__text-container">
        <p class="offer__content-subheading">
          Projektujemy i produkujemy opakowania oraz torby firmowe, które łączą
          estetykę z funkcjonalnością. Oferujemy szeroki wybór wykrojników,
          uszlachetnień i personalizacji — nawet przy niskich nakładach.
        </p>

        <ul class="offer__content-text">
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Torby bawełniane (CMYK / sito)</a>
          </li>
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Torby papierowe ze sznurkiem</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Torby ze wstążką</a>
          </li>
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Torby pionowe i poziome</a>
          </li>
          <li><a href="#"><Icon name="mdi:arrow-right" /> Torby na wino</a></li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Pudełka z magnesem</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Pudełka fasonowe</a>
          </li>
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Pudełka na zamówienie</a>
          </li>
          <li>
            <a href="#"
              ><Icon name="mdi:arrow-right" /> Nadruk na gotowych pudełkach</a>
          </li>
          <li>
            <a href="#"><Icon name="mdi:arrow-right" /> Projekty firmowe</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</section>

<script>
  const headings = document.querySelectorAll(".offer__content-heading");
  const contents = document.querySelectorAll(".offer__content__text-container");

  headings.forEach((heading, index) => {
    heading.addEventListener("click", () => {
      headings.forEach((h) => h.classList.remove("active"));
      contents.forEach((c) => c.classList.remove("active"));

      heading.classList.add("active");
      contents[index].classList.add("active");
    });
  });
</script>
