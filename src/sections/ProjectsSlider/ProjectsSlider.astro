---
import { Image } from "astro:assets";
import "./ProjectsSlider.styles.scss";
import "./ProjectsSlider.responsive.styles.scss"
import Image1 from "../../assets/images/hero-slider/1.webp";
import Image2 from "../../assets/images/hero-slider/2.webp";
import Image3 from "../../assets/images/hero-slider/3.webp";
---

<section class="projects-slider">
  <div id="projects-slider" class="animate-on-scroll">
    <div class="project-container">
      <figure class="project-container__image-container">
        <Image
          class="project-container__image"
          src={Image1}
          alt="Project Image"
        />
      </figure>
      <div class="project-container__text-container">
        <h4 class="project-container__heading">Black House</h4>
        <p class="project-container__description">
          projekt techniczny / druk / produkcja / montaż / projektowanie /
          wizualizacje / konsultacje / nadzór autorski
        </p>
      </div>
    </div>
    <div class="project-container">
      <figure class="project-container__image-container">
        <Image
          class="project-container__image"
          src={Image2}
          alt="Project Image"
        />
      </figure>
      <div class="project-container__text-container">
        <h4 class="project-container__heading">Kraków Congress Centre</h4>
        <p class="project-container__description">
          projekt techniczny / druk / produkcja / montaż / projektowanie /
          wizualizacje / konsultacje / nadzór autorski
        </p>
      </div>
    </div>
    <div class="project-container">
      <figure class="project-container__image-container">
        <Image
          class="project-container__image"
          src={Image3}
          alt="Project Image"
        />
      </figure>
      <div class="project-container__text-container">
        <h4 class="project-container__heading">Aluprof</h4>
        <p class="project-container__description">
          projekt techniczny / druk / produkcja / montaż / projektowanie /
          wizualizacje / konsultacje / nadzór autorski
        </p>
      </div>
    </div>
  </div>
  <div class="projects-slider__mobile-indicator" aria-hidden="true">
    <div class="projects-slider__mobile-indicator__bar"></div>
  </div>
</section>

<script>
  function initProjectsSlider() {
    const section = document.querySelector(
      ".projects-slider",
    ) as HTMLElement | null;
    const slider = document.getElementById(
      "projects-slider",
    ) as HTMLElement | null;

    if (!section || !slider) return;

    // If on tablet or smaller, disable JS-driven slider and rely on native
    // scroll-snap behavior. Still add a small indicator that reflects
    // native scroll position.
    if (isMobileBreakpoint()) {
      // Ensure any transforms are cleared so native scrolling works
      slider.style.transform = "";

      const track = section.querySelector(
        ".projects-slider__mobile-indicator",
      ) as HTMLElement | null;
      const indicator = section.querySelector(
        ".projects-slider__mobile-indicator__bar",
      ) as HTMLElement | null;

      function updateIndicator() {
        if (!indicator || !track) return;
        const max = slider.scrollWidth - slider.clientWidth;
        const progress = max > 0 ? slider.scrollLeft / max : 0;

        const trackW = track.clientWidth;
        // Calculate bar width proportional to visible area; clamp to reasonable min
        const ratio = slider.clientWidth / slider.scrollWidth || 1;
        const barW = Math.max(24, Math.round(ratio * trackW));
        const maxLeft = Math.max(0, trackW - barW);

        indicator.style.width = `${barW}px`;
        indicator.style.left = `${Math.round(progress * maxLeft)}px`;
      }

      // Update on load and scroll
      updateIndicator();
      slider.addEventListener("scroll", updateIndicator, { passive: true });

      // Do not attach the heavy JS loop for desktop interactions
      return;
    }

    // Lerp factor: higher = snappier, lower = more inertia.
    const LERP = 0.08;

    let current = 0; // rendered position
    let target = 0; // lerp destination
    let scrollBase = 0; // scroll-driven position (recalculated on scroll)
    let dragOffset = 0; // cumulative drag adjustment on top of scrollBase
    let rafId: number;

    let manualHorizontalScroll = false;
    let touchStartX = 0;
    let touchStartY = 0;
    let lastScrollY = window.scrollY;

    // ── Drag state ────────────────────────────────────────────────────────────
    let isDragging = false;
    let dragStartX = 0;
    let dragStartOffset = 0;
    let lastDragX = 0;
    let dragVelocity = 0; // for momentum on release

    function isMobileBreakpoint() {
      return window.matchMedia("(max-width: 1024px)").matches;
    }

    function getMaxShift(): number {
      const firstCard = slider!.querySelector(
        ".project-container",
      ) as HTMLElement | null;
      if (!firstCard) return 0;
      const gap =
        4 * parseFloat(getComputedStyle(document.documentElement).fontSize);
      return firstCard.offsetWidth + gap;
    }

    function clamp(value: number, min: number, max: number) {
      return Math.min(Math.max(value, min), max);
    }

    function calcScrollBase(): number {
      const rect = section!.getBoundingClientRect();
      const windowH = window.innerHeight;
      const total = windowH + section!.offsetHeight;
      const progress = clamp((windowH - rect.top) / total, 0, 1);
      return -progress * getMaxShift() * 1.2;
    }

    function resetTransformForManualScroll() {
      manualHorizontalScroll = true;
      cancelAnimationFrame(rafId);
      current = 0;
      target = 0;
      dragOffset = 0;
      scrollBase = 0;
      slider!.style.transform = "";
    }

    function tick() {
      if (manualHorizontalScroll) return;

      const maxShift = getMaxShift();
      const rawTarget = scrollBase + dragOffset;
      target = clamp(rawTarget, -maxShift, 0);

      current += (target - current) * LERP;

      slider!.style.transform = `translateX(${current}px)`;

      if (Math.abs(target - current) > 0.05 || isDragging) {
        rafId = requestAnimationFrame(tick);
      } else {
        current = target;
        slider!.style.transform = `translateX(${current}px)`;
      }
    }

    function startLoop() {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(tick);
    }

    // ── Scroll handler ────────────────────────────────────────────────────────
    window.addEventListener(
      "scroll",
      () => {
        const verticalDistance = Math.abs(window.scrollY - lastScrollY);

        if (manualHorizontalScroll && verticalDistance > 10) {
          manualHorizontalScroll = false;
          dragOffset = 0;
          current = 0;
          target = 0;
          section!.scrollLeft = 0;
          scrollBase = calcScrollBase();
          startLoop();
        } else if (!manualHorizontalScroll) {
          scrollBase = calcScrollBase();
          startLoop();
        }

        lastScrollY = window.scrollY;
      },
      { passive: true },
    );

    window.addEventListener("resize", () => {
      if (!manualHorizontalScroll) {
        scrollBase = calcScrollBase();
        startLoop();
      }
    });

    // ── Pointer / drag handlers ───────────────────────────────────────────────
    section.addEventListener("pointerdown", (e: PointerEvent) => {
      if (e.pointerType === "touch" || isMobileBreakpoint()) {
        touchStartX = e.clientX;
        touchStartY = e.clientY;
        manualHorizontalScroll = false;
        return;
      }

      isDragging = true;
      dragStartX = e.clientX;
      dragStartOffset = dragOffset;
      lastDragX = e.clientX;
      dragVelocity = 0;
      section!.setPointerCapture(e.pointerId);
      section!.style.cursor = "grabbing";
      startLoop();
    });

    section.addEventListener("pointermove", (e: PointerEvent) => {
      if (e.pointerType === "touch" || isMobileBreakpoint()) {
        const dx = e.clientX - touchStartX;
        const dy = e.clientY - touchStartY;

        if (!manualHorizontalScroll && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) {
          resetTransformForManualScroll();
        }

        return;
      }

      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      dragVelocity = e.clientX - lastDragX;
      lastDragX = e.clientX;
      dragOffset = dragStartOffset + dx;
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerType === "touch" || isMobileBreakpoint()) return;
      if (!isDragging) return;
      isDragging = false;
      section!.style.cursor = "grab";

      // Throw momentum: carry the drag velocity forward as extra offset
      dragOffset += dragVelocity * 6;
      startLoop();
    };

    section.addEventListener("pointerup", endDrag);
    section.addEventListener("pointercancel", endDrag);

    // Prevent click-through after a drag
    section.addEventListener(
      "click",
      (e: MouseEvent) => {
        if (Math.abs(dragOffset - dragStartOffset) > 5) e.stopPropagation();
      },
      true,
    );

    // ── Init ──────────────────────────────────────────────────────────────────
    section.style.cursor = "grab";
    scrollBase = calcScrollBase();
    startLoop();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectsSlider);
  } else {
    initProjectsSlider();
  }
</script>
