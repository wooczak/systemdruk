---
import { Image } from "astro:assets";
import "./ProjectsSlider.styles.scss";
import Image1 from "../../assets/images/hero-slider/1.webp";
import Image2 from "../../assets/images/hero-slider/2.webp";
import { Icon } from "astro-icon/components";
---

<section>

<div id="projects-slider" class="animate-on-scroll">
  <div class="project-container">
    <figure class="project-container__image-container">
      <Image
        class="project-container__image"
        src={Image1}
        alt="Project Image"
      />
    </figure>
    <div class="project-container__text-container">
      <h4 class="project-container__heading">Black House</h4>
      <p class="project-container__description">
        projekt techniczny / druk / produkcja / montaż / projektowanie /
        wizualizacje / konsultacje / nadzór autorski
      </p>
    </div>
  </div>
  <div class="project-container">
    <figure class="project-container__image-container">
      <Image
        class="project-container__image"
        src={Image2}
        alt="Project Image"
      />
    </figure>
    <div class="project-container__text-container">
      <h4 class="project-container__heading">White House</h4>
      <p class="project-container__description">
        Description of the White House project.
      </p>
    </div>
  </div>
</div>

<div class="projects-slider__arrow-container">
  <Icon name="custom-arrow-left" />
  <Icon name="custom-arrow-right" />
</div>
</section>
