---
import { Icon } from "astro-icon/components";
import SecondaryButton from "../../components/Buttons/SecondaryButton.astro";
import Subheading from "../../components/Subheading/Subheading.astro";
import { ContactFormClientComponent as Form } from "./ContactForm.client";
import "./ContactForm.styles.scss";
import Image from "astro/components/Image.astro";
import ImageSrc from "../../assets/images/contact-form-photo.jpg";
---

<section class="contact-form">
  <h1 class="contact-form__title">Porozmawiajmy o Twoim projekcie</h1>
  <Subheading
    labels={["Bez zobowiązań", "Szybka odpowiedź", "Profesjonalne doradztwo"]}
  />
  <div class="contact-form__client-container">
    <div>
      <Form client:load />
      <SecondaryButton title="Wyslij wiadomosc" icon="mdi:arrow-right-thin" />
    </div>
    <div class="contact-form__contact-details-container">
      <div class="contact-form__contact-details-wrapper">
        <h5>Skontaktuj sie bezposrednio</h5>
        <figure>
          <Image src={ImageSrc} alt="Contact form photo" />
          <figcaption>
            <h5>Katarzyna Łuczak</h5>
            <p>Założycielka System Druk</p>
          </figcaption>
        </figure>
        <ul>
          <li>
            <Icon name="mdi:email" />
            <a href="mailto:kl@systemdruk.pl">kl@systemdruk.pl</a>
          </li>
          <li>
            <Icon name="mdi:phone" />
            <a href="tel:+4796070776">+47 960 70 776</a>
          </li>
        </ul>
      </div>
    </div>
  </div> 
</section>
