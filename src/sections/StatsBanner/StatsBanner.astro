      <span class="stats-banner__number">+350</span>
      <p class="stats-banner__text">zrealizowanych projektów</p>
    </div>
    <div class="stats-banner__content">
      <span class="stats-banner__number">+100</span>
      <p class="stats-banner__text">zadowolonych klientów</p>
    </div>
    <div class="stats-banner__content">
      <span class="stats-banner__number">+10 lat</span>
      <p class="stats-banner__text">doświadczenia w branży</p>
    </div>
  </div>
</section>
