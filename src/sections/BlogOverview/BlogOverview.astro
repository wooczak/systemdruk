---
import "./BlogOverview.styles.scss";
import { getCollection } from "astro:content";
import SecondaryButton from "../../components/Buttons/SecondaryButton.astro";

const allPosts = await getCollection("blog");

const allPostsLength = allPosts.length;

const allPostsDetails = allPosts
  .sort(({ data: dataA }, { data: dataB }) => {
    const dateA = new Date(dataA.post_date);
    const dateB = new Date(dataB.post_date);

    return dateB.getTime() - dateA.getTime();
  })
  .map(({ data }, index) => {
    if (index >= 3) return null;

    return {
      title: data.title,
      author: data.author,
      date: data.post_date,
      categories: data.categories,
      img_url: data.img_url,
      slug: data.slug,
    };
  });
---

<section id="blog-overview" class="blog-overview">
  <h3 class="blog-overview__title">W świecie druku</h3>
  <div class="blog-overview__container">
    {
      allPostsDetails.map((post, index) => {
        if (!post) return null;

        const isMain = index === 0;
        const isSidebarFirst = index === 1;

        const cl = isMain
          ? "blog-overview__main-post"
          : isSidebarFirst
            ? "blog-overview__sidebar-post-1"
            : "blog-overview__sidebar-post-2";

        return (
          <article class={cl}>
            <img
              src={post.img_url}
              class="blog-overview__container__image"
              alt={post.title}
              width={isMain ? 600 : 300}
              height={isMain ? 400 : 200}
            />
            <div class={`${cl}__content`}>
              <p class="blog-overview__container__categories">
                [{post.categories.join(", ")}]
              </p>
              <h4>{post.title}</h4>
            </div>
          </article>
        );
      })
    }
  </div>
  <SecondaryButton
    class="blog-overview__button"
    title={`Jeszcze więcej wiedzy (${allPostsLength})`}
  />
</section>
