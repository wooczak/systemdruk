---
import { getCollection } from "astro:content";
import Layout from "../../layout/index.astro";
import "./styles.scss";
import { Image } from "astro:assets";

const allPosts = await getCollection("blog");

const posts = allPosts.map((post) => ({
  ...post,
  preview: post.body?.slice(0, 250) + "...",
}));
---

<Layout>
  <section class="all-blog-posts-page">
    {
      posts.map((post) => (
        <a href={import.meta.env.BASE_URL + "/blog/" + post.data.slug}>
        <div class="blog-post-container">
          <Image
            class="blog-post__image"
            alt={post.data.slug}
            width="100"
            height="200"
            src={import.meta.env.BASE_URL + post.data.img_url}
          />
          <h3 class="blog-post__title">{post.data.title}</h3>
          <p class="blog-post__author">Autor: {post.data.author}</p>
          <p class="blog-post__preview">{post.preview}</p>
        </div>
        </a>
      ))
    }
  </section>
</Layout>
