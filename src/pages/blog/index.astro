---
import { getCollection } from "astro:content";
import Layout from "../../layout/index.astro";
import "./styles.scss";
import { Image } from "astro:assets";
import Breadcrumbs from "../../components/Breadcrumbs/Breadcrumbs.astro";
import SecondaryButton from "../../components/Buttons/SecondaryButton.astro";

const allPosts = await getCollection("blog");

function stripMarkdown(md: string | undefined, title: string): string {
  if (!md) return "";

  // remove title from the beginning
  md = md.replace(title, "");
  // remove code fences
  md = md.replace(/```[\s\S]*?```/g, "");
  // inline code
  md = md.replace(/`([^`]*)`/g, "$1");
  // images and links: ![alt](url) -> alt, [text](url) -> text
  md = md.replace(/!\[([^\]]*)\]\([^\)]*\)/g, "$1");
  md = md.replace(/\[([^\]]*)\]\([^\)]*\)/g, "$1");
  // headings (#, ##, etc.)
  md = md.replace(/^#+\s?/gm, "");
  // blockquotes
  md = md.replace(/^\s{0,3}>\s?/gm, "");
  // bold/italic
  md = md.replace(/(\*\*|__)(.*?)\1/g, "$2");
  md = md.replace(/(\*|_)(.*?)\1/g, "$2");
  // remaining markdown chars
  md = md.replace(/[*_~]/g, "");
  // strip HTML tags
  md = md.replace(/<\/?[^>]+(>|$)/g, "");
  // collapse whitespace
  md = md.replace(/\s+/g, " ").trim();
  return md;
}

const posts = allPosts.map((post) => ({
  ...post,
  preview: stripMarkdown(post.body, post.data.title).slice(0, 250) + "...",
}));
---

<Layout>
  <section class="all-blog-posts-page">
    <div class="all-blog-posts-page__breadcrumbs">
      <Breadcrumbs />
    </div>
    <h1 class="all-blog-posts-page__heading">Ze świata druku</h1>
    <div class="all-blog-posts-page__categories">
      <SecondaryButton
        title="Wszystkie artykuly"
        active={true}
        dataCategory="all"
      />
      {
        [...new Set(posts.flatMap((post) => post.data.categories))].map(
          (category) => (
            <SecondaryButton title={category} dataCategory={category} />
          )
        )
      }
    </div>
    <div class="all-blog-posts">
      {
        posts.map((post) => (
          <a href={import.meta.env.BASE_URL + "/blog/" + post.data.slug}>
            <div
              class="blog-post-container"
              data-categories={post.data.categories.join(",")}
            >
              <Image
                class="blog-post__image"
                alt={post.data.slug}
                width="100"
                height="200"
                src={import.meta.env.BASE_URL + post.data.img_url}
              />
              <div>
                <h3 class="blog-post__title">{post.data.title}</h3>
                <p class="blog-post__author">Autor: {post.data.author}</p>
              </div>
              <p class="blog-post__preview">{post.preview}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const categoryButtons = document.querySelectorAll(
      ".all-blog-posts-page__categories .secondary-button"
    );
    const blogPosts = document.querySelectorAll(".blog-post-container");
    const allCategoryButton = document.querySelector(
      'button[data-category="all"]'
    );


    const activeCategories = new Set();
    const blogPostMap = new Map();

    // Populate the blogPostMap once
    blogPosts.forEach((post) => {
      const postCategories = post.getAttribute("data-categories")?.split(",");
      blogPostMap.set(post, postCategories);
    });

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.getAttribute("data-category");

        console.log(category);

        // Handle "All" button logic
        if (category === "all") {
          activeCategories.clear();
          categoryButtons.forEach((btn) =>
            btn.classList.remove("secondary-button--active")
          );
          button.classList.add("secondary-button--active");
        } else {
          allCategoryButton?.classList.remove("secondary-button--active");

          if (activeCategories.has(category)) {
            activeCategories.delete(category);
            button.classList.remove("secondary-button--active");
          } else {
            activeCategories.add(category);
            button.classList.add("secondary-button--active");

            // Remove "All" button's active state
            document
              .querySelector('[data-category="all"]')
              ?.classList.remove("secondary-button--active");
          }
        }

        // Filter blog posts based on active categories
        filterBlogPosts();
      });
    });

    function filterBlogPosts() {
      blogPosts.forEach((post) => {
        const postCategories = blogPostMap.get(post);

        // Show post if no categories are selected or if it matches any active category
        if (
          activeCategories.size === 0 ||
          postCategories?.some((cat) => activeCategories.has(cat))
        ) {
          (post as HTMLDivElement).style.display = "grid";
        } else {
          (post as HTMLDivElement).style.display = "none";
        }
      });
    }
  });
</script>
