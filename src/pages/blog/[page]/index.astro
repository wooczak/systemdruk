---
import { getCollection, render } from "astro:content";
import Layout from "../../../layout/index.astro";
import "./styles.scss";
import SecondaryButton from "../../../components/Buttons/SecondaryButton.astro";

const allPosts = await getCollection("blog");

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { page: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout>
  <section class="blog-page">
    <img
      class="blog-page__img"
      alt={post.data.slug}
      src={import.meta.env.BASE_URL + "/" + post.data.img_url}
    />
    <section class="blog-page__content-container">
      <aside class="blog-page__aside">
        <div class="blog-page__author-box">
          <p class="blog-page__author-box__categories">[{post.data.categories.join(", ")}]</p>
          <p class="blog-page__author-box__author">Autor: {post.data.author}</p>
          <p class="blog-page__author-box__date">
            {
              new Intl.DateTimeFormat("en-GB").format(
                new Date(post.data.post_date)
              )
            }
          </p>
        </div>
        <h5 class="blog-page__newest-posts__heading">Najnowsze posty</h5>
        {
          allPosts
            .slice(0, 3)
            .sort(
              (a, b) =>
                new Date(b.data.post_date).getTime() -
                new Date(a.data.post_date).getTime()
            )
            .map((post) => (
              <div class="blog-page__newest-posts__post-block">
                <p class="blog-page__newest-posts__categories">[{post.data.categories.join(",")}]</p>
                <h6 class="blog-page__newest-posts__post-title">{post.data.title}</h6>
              </div>
            ))
        }
        <SecondaryButton title={`Więcej wiedzy (${allPosts.length})`}/>
      </aside>
      <article class="blog-page__content">
        <Content />
      </article>
      <div></div>
    </section>
  </section>
</Layout>
